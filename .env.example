# Copy to .env.local and fill in. NEVER commit real values.
# All variables are server-only: do not prefix with NEXT_PUBLIC_.

# --- Google Sheets (Phase 2) -------------------------------------------------
# ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# "client_email" from the service-account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# "private_key" from the JSON key. Keep the quotes; newlines are written as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# IANA timezone used for the Activity "Date" column (daily targets). Default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# --- Auth (Phase 1) ----------------------------------------------------------
# Long random string (>= 32 chars), e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-long-random-string
SESSION_MAX_AGE_SECONDS=28800

# Per-member access codes. Keep as strings (leading zeros matter).
# Prototype values are documented in phases.md; rotate before production.
ACCESS_CODE_ANNI=replace-me
ACCESS_CODE_LUKKY=replace-me
ACCESS_CODE_RISHII=replace-me

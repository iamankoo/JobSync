# Copy to .env.local and fill in. NEVER commit real values.
# All variables are server-only: do not prefix with NEXT_PUBLIC_.

# --- Google Sheets (Phase 2) -------------------------------------------------
# ID from the spreadsheet URL: https://docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id
# "client_email" from the service-account JSON key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# "private_key" from the JSON key. Keep the quotes; newlines are written as \n
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nREPLACE_ME\n-----END PRIVATE KEY-----\n"
# IANA timezone used for the Activity "Date" column (daily targets). Default: Asia/Kolkata
APP_TIMEZONE=Asia/Kolkata

# --- Auth (Phase 1) ----------------------------------------------------------
# Long random string (>= 32 chars), e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-long-random-string
SESSION_MAX_AGE_SECONDS=2592000

# Per-member access codes. Keep as strings (leading zeros matter).
# Prototype values are documented in phases.md; rotate before production.
ACCESS_CODE_ANNI=replace-me
ACCESS_CODE_LUKKY=replace-me
ACCESS_CODE_RISHII=replace-me

# --- Phase 4 -----------------------------------------------------------------
# Bearer secret for GET /api/cron/retention (30-day cleanup). Long random string.
CRON_SECRET=replace-with-long-random-string
# Destructive 30-day cleanup stays OFF until you have reviewed a dry run. Set to true to enable.
RETENTION_CLEANUP_ENABLED=false
# Short in-process read cache for Sheets reads (ms). 0 disables it.
SHEETS_CACHE_TTL_MS=3000
# How often open pages re-fetch data so other members' changes appear (ms). Public value.
NEXT_PUBLIC_AUTO_REFRESH_MS=30000

# --- Push notifications (see docs/notifications) -----------------------------
# Generate with `npx web-push generate-vapid-keys --json`. The private key is server-only: never prefix with NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
VAPID_SUBJECT=mailto:you@example.com
# CRON_SECRET (above) also protects GET /api/cron/daily-notifications?slot=morning|night

# --- Network Finder (Phase 2, see docs/network-finder) -----------------------
# Everything stays OFF unless this is "true". Free public sources do the work; Apollo is optional.
NETWORK_FINDER_ENABLED=false
# Protects GET /api/cron/network-finder (cron-job.org sends "Authorization: Bearer <this>"). Long random string.
NETWORK_FINDER_CRON_SECRET=
# Member recorded as "Added by" on discovered Connections / Jobs (anni | lukky | rishii).
NETWORK_FINDER_CONTACT_OWNER=anni
NETWORK_FINDER_JOB_OWNER=anni
# Each member's own profile for their drafts (the ONLY facts a draft may state about them). Plain text, ≤1500 chars.
NETWORK_FINDER_PROFILE_ANNI=
NETWORK_FINDER_PROFILE_LUKKY=
NETWORK_FINDER_PROFILE_RISHII=
# Each member's email signature, appended unchanged under their own drafts (≤500 chars; write line breaks as \n).
NETWORK_FINDER_SIGNATURE_ANNI=
NETWORK_FINDER_SIGNATURE_LUKKY=
NETWORK_FINDER_SIGNATURE_RISHII=
# Optional tuning (defaults shown).
# NETWORK_FINDER_CONTACT_LIMIT=1000        (Connections size at which new contacts stop + all three are told)
# NETWORK_FINDER_BATCH_SIZE=10
# NETWORK_FINDER_PEOPLE_PER_COMPANY=3
# NETWORK_FINDER_MAX_COMPANIES_PER_TICK=1
# NETWORK_FINDER_JOB_RECHECK_HOURS=24
# NETWORK_FINDER_DAILY_INTERNSHIPS=5
# NETWORK_FINDER_DAILY_FULL_TIME=5
# Apollo accounts (OPTIONAL; server-only secrets). Account 1 is used first; when its daily/minute limit or credits
# run out, account 2, then 3 ... Unset slots are skipped. A plan restriction never stops the free pipeline.
# Keys never appear in the UI, logs, notifications or sheets.
APOLLO_API_KEY_1=
APOLLO_API_KEY_2=
APOLLO_API_KEY_3=
APOLLO_API_KEY_4=
APOLLO_API_KEY_5=
APOLLO_API_KEY_6=
APOLLO_API_KEY_7=
APOLLO_API_KEY_8=
APOLLO_API_KEY_9=
APOLLO_API_KEY_10=
# Calls/credits per account per day. REQUIRED once keys exist: unset = 0 = the account is never used.
APOLLO_DAILY_LIMIT=
# APOLLO_DAILY_LIMIT_1=        (optional per-account override, likewise _2 … _10)
APOLLO_PER_MINUTE_LIMIT=5
# Which accounts the scheduled pipeline may use (comma-separated numbers). Default "1": other keys stay unused.
# APOLLO_ENABLED_ACCOUNTS=1

# --- Nemotron (NVIDIA API, OpenAI-compatible) — the Network Finder's "brain" ---
# Decides and drafts only; it never sends anything.
NEMOTRON_API_KEY=
# Model ID from build.nvidia.com (required when the key is set)
NEMOTRON_MODEL=
# NEMOTRON_BASE_URL=https://integrate.api.nvidia.com/v1
# NEMOTRON_MAX_RPM=30        (client-side pacing under NVIDIA's per-minute limit)
# NEMOTRON_THINKING=false

# --- Gmail drafts (OAuth; each member authorises their own Gmail at /gmail) ---
# NEVER put Gmail passwords or app passwords anywhere. See docs/network-finder/gmail-oauth.md.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Must exactly match an "Authorised redirect URI" of the OAuth client:
#   local:      http://localhost:3000/api/gmail/callback
#   production: https://jobsbyarillabs.vercel.app/api/gmail/callback
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/gmail/callback
# 32 random bytes, base64: `openssl rand -base64 32`. Encrypts stored Gmail refresh tokens. Different per environment.
GMAIL_TOKEN_ENCRYPTION_KEY=
# "Sent" tracking: when true, members are also asked for Gmail's read-only METADATA permission (labels/headers,
# never bodies) so a sent Network Finder draft can move the Connection to "Messaged". Off = statuses never change.
GMAIL_TRACK_SENT=false

# ---- Profile Lock -----------------------------------------------------------------------------------------
# Anni's "Another way to unlock": the scrypt hash (format scrypt1$<salt>$<hash>) of the recovery answer, trimmed
# and lower-cased. Server-only; never put the answer itself anywhere. Empty = the option says it is not set up.
PROFILE_RECOVERY_ANSWER_HASH=
